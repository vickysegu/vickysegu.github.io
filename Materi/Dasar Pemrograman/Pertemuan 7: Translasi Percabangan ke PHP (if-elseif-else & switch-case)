        // Handlers Slide 17: Drag & Drop 8 Langkah Skrip PHP Diskon & Pajak
        function shufflePhpSteps() {
            phpStepsOrder = [...CORRECT_PHP_BRANCH_STEPS].sort(function () { return Math.random() - 0.5; });
            phpShowValidation = false;
            phpFeedbackText = '';
            renderCurrentSlide();
        }
        function movePhpStep(index, direction) {
            const target = index + direction;
            if (target < 0 || target >= phpStepsOrder.length) return;
            const moved = phpStepsOrder.splice(index, 1)[0];
            phpStepsOrder.splice(target, 0, moved);
            phpShowValidation = false;
            phpFeedbackText = '';
            renderCurrentSlide();
        }
        function onPhpDragStart(e, index) {
            draggedPhpIndex = index;
            if (e.currentTarget) e.currentTarget.classList.add('dragging');
            if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
        }
        function onPhpDragOver(e, index) {
            e.preventDefault();
            if (index !== draggedPhpIndex && e.currentTarget) e.currentTarget.classList.add('drag-over');
        }
        function onPhpDragLeave(e) {
            if (e.currentTarget) e.currentTarget.classList.remove('drag-over');
        }
        function onPhpDrop(e, targetIndex) {
            e.preventDefault();
            if (draggedPhpIndex !== null && draggedPhpIndex !== targetIndex) {
                const moved = phpStepsOrder.splice(draggedPhpIndex, 1)[0];
                phpStepsOrder.splice(targetIndex, 0, moved);
                phpShowValidation = false;
                phpFeedbackText = '';
                renderCurrentSlide();
            }
            draggedPhpIndex = null;
        }
        function onPhpDragEnd() {
            draggedPhpIndex = null;
            document.querySelectorAll('.draggable-step').forEach(function (el) {
                el.classList.remove('dragging', 'drag-over');
            });
        }
        function checkPhpOrder() {
            phpShowValidation = true;
            let correctCount = 0;
            for (let i = 0; i < phpStepsOrder.length; i++) {
                if (phpStepsOrder[i].id === i + 1) correctCount++;
            }
            if (correctCount === phpStepsOrder.length) {
                phpFeedbackText = 'Luar Biasa (8/8 Tepat)! Alur skrip PHP Diskon, DPP, & Pajak Warung Digital sudah 100% runtut!';
            } else {
                phpFeedbackText = 'Baru ' + correctCount + '/8 tahap yang tepat. Geser baris bertanda "✗ Geser".';
            }
            renderCurrentSlide();
        }

        function answerSelfCheck(qNum, isOk, msg) {
            selfCheckFeedback[qNum] = { ok: isOk, msg: msg };
            renderCurrentSlide();
        }

        // Modal Istilah & Kamus Lengkap
        function showTerm(key) {
            const item = GLOSSARY_DB[key];
            if (!item) return;

            document.getElementById('termCategoryBadge').textContent = item.category;
            document.getElementById('termTitle').textContent = item.title;
            document.getElementById('termMainDesc').textContent = item.main;
            document.getElementById('termDetailDesc').textContent = item.detail;
            document.getElementById('termSourceName').textContent = "Sumber: " + item.source;

            const modal = document.getElementById('termModalBackdrop');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeTermModal() {
            const modal = document.getElementById('termModalBackdrop');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function openGlossaryIndex() {
            document.getElementById('glossarySearchInput').value = '';
            renderGlossaryList('');
            const modal = document.getElementById('glossaryModalBackdrop');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeGlossaryIndex() {
            const modal = document.getElementById('glossaryModalBackdrop');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function selectGlossaryTerm(key) {
            closeGlossaryIndex();
            showTerm(key);
        }

        function renderGlossaryList(query) {
            const q = String(query || '').trim().toLowerCase();
            const allKeys = Object.keys(GLOSSARY_DB);
            const matchedKeys = [];

            for (let i = 0; i < allKeys.length; i++) {
                const k = allKeys[i];
                const item = GLOSSARY_DB[k];
                if (
                    item.title.toLowerCase().indexOf(q) !== -1 ||
                    item.category.toLowerCase().indexOf(q) !== -1 ||
                    item.main.toLowerCase().indexOf(q) !== -1
                ) {
                    matchedKeys.push(k);
                }
            }

            const container = document.getElementById('glossaryListGrid');
            if (matchedKeys.length === 0) {
                container.innerHTML = '<div class="col-span-2 text-center py-8 text-xs text-slate-500">Istilah tidak ditemukan.</div>';
                return;
            }

            let html = '';
            for (let i = 0; i < matchedKeys.length; i++) {
                const k = matchedKeys[i];
                const item = GLOSSARY_DB[k];
                html += `
                    <button type="button" onclick="selectGlossaryTerm('${k}')" class="text-left p-4 rounded-2xl bg-slate-50 hover:bg-indigo-50/60 dark:bg-slate-800/50 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-800 transition space-y-1">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">${escapeHtml(item.category)}</span>
                            <span class="text-[10px] text-slate-400">${escapeHtml(item.source)}</span>
                        </div>
                        <div class="text-sm font-extrabold text-slate-900 dark:text-white">${escapeHtml(item.title)}</div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2">${escapeHtml(item.main)}</p>
                    </button>
                `;
            }

            container.innerHTML = html;
        }

        function toggleTheme() {
            const htmlEl = document.documentElement;
            const icon = document.getElementById('themeIcon');
            htmlEl.classList.toggle('dark');
            const isDark = htmlEl.classList.contains('dark');
            icon.className = isDark ? 'fa-solid fa-sun text-amber-400 text-sm' : 'fa-solid fa-moon text-sm';
        }

        document.addEventListener('keydown', function (e) {
            const activeTag = document.activeElement && document.activeElement.tagName
                ? document.activeElement.tagName.toLowerCase()
                : '';
            if (activeTag === 'input' || activeTag === 'textarea' || activeTag === 'select') return;

            if (e.key === 'ArrowRight') changeSlide(1);
            if (e.key === 'ArrowLeft') changeSlide(-1);
            if (e.key === 'Escape') {
                closeTermModal();
                closeGlossaryIndex();
            }
        });

        window.onload = function () {
            renderCurrentSlide();
        };
    </script>
</body>
</html>
